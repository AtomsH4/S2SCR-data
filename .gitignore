# Publish only this explicit release allowlist; local archives remain on disk.
/*
!/.gitignore
!/README.md
!/LICENSE
!/TERMS.md
!/CITATION.cff
!/requirements.txt
!/verify_public_integrity.py
!/PUBLIC_CHECKSUMS.sha256
!/release/
/release/*
!/release/calibration/
!/release/observations/
!/release/manifest.json
!/release/protocol.json
!/release/sources.json
/release/calibration/*
!/release/calibration/simx4.mat
!/release/calibration/simx8.mat
/release/observations/*
!/release/observations/simx4/
!/release/observations/simx8/
/release/observations/simx4/*
!/release/observations/simx4/paviau.mat.zip
!/release/observations/simx4/chikusei.mat.zip
!/release/observations/simx4/wadc.mat.zip
/release/observations/simx8/*
!/release/observations/simx8/paviau.mat.zip
!/release/observations/simx8/chikusei.mat.zip
!/release/observations/simx8/wadc.mat.zip
